# --- обязательные ---
# Адрес панели (можно с /api на конце или без)
PANEL_URL=https://remwebpanel.twilightparadox.com/api
# API-токен панели (Remnawave → Settings → API Tokens)
PANEL_API_TOKEN=
# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=
# ID чата/группы/канала для алертов (у групп начинается с -100...)
TELEGRAM_CHAT_ID=

# --- необязательные ---
# ID топика, если группа с темами
TELEGRAM_THREAD_ID=
# Название в заголовке сообщений
PANEL_NAME=Remnawave
# Интервал проверки, сек
CHECK_INTERVAL=60
# Сколько неудачных проверок подряд до алерта «упало»
FAIL_THRESHOLD=3
# Сколько удачных проверок подряд до алерта «восстановилось»
RECOVER_THRESHOLD=2
# Напоминание, если проблема не ушла, сек (0 = не напоминать)
REMIND_INTERVAL=10800
# Таймаут HTTP-запросов, сек
REQUEST_TIMEOUT=15
# Алертить ли по нодам, отключённым в панели вручную
ALERT_ON_DISABLED=true
# Сообщение «мониторинг запущен» при старте
STARTUP_MESSAGE=true
# Файл состояния (чтобы после рестарта не было повторных алертов)
STATE_FILE=state.json
LOG_LEVEL=INFO
