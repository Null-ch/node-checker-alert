# --- обязательные ---
# Адрес панели (можно с /api на конце или без)
PANEL_URL=https://panel/api
# API-токен панели (Remnawave → Settings → API Tokens)
PANEL_API_TOKEN=
# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=
# ID чата/группы/канала для алертов (у групп начинается с -100...)
TELEGRAM_CHAT_ID=

# --- необязательные ---
# ID топика, если группа с темами
TELEGRAM_THREAD_ID=
# Название в заголовке сообщений
PANEL_NAME=Remnawave
# Интервал проверки, сек
CHECK_INTERVAL=60
# Сколько неудачных проверок подряд до алерта «упало»
FAIL_THRESHOLD=3
# Сколько удачных проверок подряд до алерта «восстановилось»
RECOVER_THRESHOLD=2
# Напоминание, если проблема не ушла, сек (0 = не напоминать)
REMIND_INTERVAL=10800
# Таймаут HTTP-запросов, сек
REQUEST_TIMEOUT=15
# Алертить ли по нодам, отключённым в панели вручную
ALERT_ON_DISABLED=true
# Сводка по панели, нодам и доступу из РФ при старте
STARTUP_MESSAGE=true
# Файл состояния (чтобы после рестарта не было повторных алертов)
STATE_FILE=state.json
LOG_LEVEL=INFO

# --- проверка прокси к Telegram Bot API ---
# Адрес прокси (пусто — не проверять). Проверяется каждый цикл запросом {TG_PROXY_URL}/bot<TELEGRAM_BOT_TOKEN>/getMe,
# алерты по общим FAIL_THRESHOLD / RECOVER_THRESHOLD / REMIND_INTERVAL
TG_PROXY_URL=https://tgapi.fq

# --- проверка доступности нод из РФ (блокировки ТСПУ) ---
# off — выключено
# local — проверять с этого сервера (только если сервер в РФ): TCP + TLS с SNI + детект «заморозки» после ~16 КБ
# checkhost — через узлы check-host.net в РФ (только TCP), для сравнения — узел за рубежом
PROBE_MODE=checkhost
# Как часто проверять, сек (не чаще 60; для checkhost лучше не меньше 600)
PROBE_INTERVAL=600
# Сколько неудачных проверок подряд до алерта
PROBE_FAIL_THRESHOLD=2
# Таймаут одной проверки (режим local), сек
PROBE_TIMEOUT=8
# Не проверять ноды из этих стран (countryCode в панели)
PROBE_SKIP_COUNTRIES=RU
# Не проверять эти ноды (имена или IP через запятую)
PROBE_EXCLUDE_NODES=
# Режим local: качать страницу через Reality, чтобы поймать «заморозку» после ~16 КБ
PROBE_FREEZE_CHECK=true
# Режим local: контрольный хост; если он недоступен — проблема в сети сервера, проверка пропускается
PROBE_CONTROL=ya.ru:443
# Режим checkhost: узлы в РФ и контрольные зарубежные узлы
CHECKHOST_NODES=ru1.node.check-host.net,ru2.node.check-host.net,ru3.node.check-host.net
CHECKHOST_CONTROL_NODES=de1.node.check-host.net
